with "runtime_build.gpr";
with "ravenscar_build.gpr";
with "config/munts_rp2040_firmware_embedded_config.gpr";

project munts_rp2040_firmware_embedded is

   for Target use runtime_build'Target;
   for Runtime ("Ada") use runtime_build'Runtime ("Ada");
   for Source_Dirs use ("config/", "src/**");
   for Object_Dir use "obj/" & munts_rp2040_firmware_embedded_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("munts_rp2040_firmware_embedded.adb");

   package Builder is
      for Default_Switches ("Ada") use ("--create-map-file");
   end Builder;

   package Compiler is
      for Default_Switches ("Ada") use munts_rp2040_firmware_embedded_Config.Ada_Compiler_Switches & ("-gnat2022", "-gnaty-g");
   end Compiler;

   package Linker is
      for Switches ("Ada") use Runtime_Build.Linker_Switches & ("-Wl,--gc-sections", "-Wl,--print-memory-usage");
   end Linker;

end munts_rp2040_firmware_embedded;
